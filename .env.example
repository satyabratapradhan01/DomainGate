# DomainGate Environment Variables
# Copy this file to .env or .env.local to supply your real Firebase & Google OAuth credentials.
# If omitted, DomainGate runs in Enterprise Simulation Mode with full cryptographic proofs.

# Firebase Project Credentials
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourLiveFirebaseApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=domaingate-hbplus.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=domaingate-hbplus
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=domaingate-hbplus.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475610
EXPO_PUBLIC_FIREBASE_APP_ID=1:102938475610:web:abcdef123456

# Google OAuth Client IDs (For native mobile builds if using standalone Google Sign-In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-client-id-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com
