# ==============================================================================
# DomainGate - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (or .env.local) and populate it with your real project values.
# 
# ⚠️ SECURITY DIRECTIVE:
# NEVER commit your actual .env file, private keys, or service account files to Git.
# Ensure that .env is listed in .gitignore at all times.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (PUBLIC IDENTIFIERS)
# ------------------------------------------------------------------------------
# In Expo, variables prefixed with EXPO_PUBLIC_ are bundled into the client runtime.
# These values identify your Firebase project to Google Cloud APIs.
# Security for these keys is enforced via:
# - Google Cloud Console API Key Restrictions (HTTP Referrer & Package Name restrictions)
# - Firebase Authentication Authorized Domains
# - Cloud Firestore Security Rules & Cloud Storage Rules
# ------------------------------------------------------------------------------

# Firebase Web API Key (from Firebase Console > Project Settings > General)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere1234567890

# Firebase Auth Domain (e.g. your-project.firebaseapp.com)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=domaingate-project-id.firebaseapp.com

# Firebase Project ID (unique Google Cloud project identifier)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=domaingate-project-id

# Firebase Storage Bucket (e.g. your-project.firebasestorage.app)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=domaingate-project-id.firebasestorage.app

# Firebase Cloud Messaging Sender ID (numerical identifier)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475610

# Firebase App ID (unique client app instance identifier)
EXPO_PUBLIC_FIREBASE_APP_ID=1:102938475610:web:abcdef1234567890abcdef

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Client IDs (PUBLIC CLIENT IDENTIFIERS)
# ------------------------------------------------------------------------------
# Used by Google Identity Services and expo-auth-session to initiate OAuth 2.0 flows.
# ------------------------------------------------------------------------------

# Google OAuth Web Client ID (Authorized JavaScript Origins: http://localhost:8081, https://your-domain.netlify.app)
# Supported keys: EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID or EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=102938475610-abcdefg123456webclientid.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=102938475610-abcdefg123456webclientid.apps.googleusercontent.com

# Google OAuth Android Client ID (Bound to your package name and SHA-1 certificate fingerprint)
# Supported keys: EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID or EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=102938475610-abcdefg123456androidclientid.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=102938475610-abcdefg123456androidclientid.apps.googleusercontent.com

# Google OAuth iOS Client ID (Bound to your iOS Bundle Identifier)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=102938475610-abcdefg123456iosclientid.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Confidential Server Secrets (NEVER INCLUDE IN CLIENT APP OR GIT)
# ------------------------------------------------------------------------------
# The following secrets belong ONLY on secure backend servers or CI/CD secrets:
#
# ❌ FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY   (Full root administrator access)
# ❌ GOOGLE_OAUTH_CLIENT_SECRET           (Web application OAuth secret key)
# ❌ GOOGLE_MAPS_SERVER_KEY               (Unrestricted server API key)
# ❌ NETLIFY_AUTH_TOKEN                   (Deploy token)
#
# DO NOT add EXPO_PUBLIC_ to confidential server secrets!
# ------------------------------------------------------------------------------
